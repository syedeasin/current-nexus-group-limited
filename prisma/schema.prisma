generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
  VIEWER
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum Locale {
  EN
  FR
}

/// Which News Room listing a post belongs to. Every post's detail page stays
/// at /news/<slug>; the section only decides which index lists it
/// (/news, /news/re-analysis, /news/knowledge-database, /news/events).
enum PostSection {
  NEWS
  RE_ANALYSIS
  KNOWLEDGE_DATABASE
  EVENTS
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  /// Optional sign-in alternative to the email address. Stored lower-case.
  username     String?   @unique
  passwordHash String
  role         Role      @default(AUTHOR)
  avatarUrl    String?
  bio          String?
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  /// Last time the password was set — by the user, an admin, or a reset link.
  passwordChangedAt DateTime?

  posts              Post[]
  media              Media[]
  downloads          DownloadResource[]
  solutionPages      SolutionPage[]
  manufacturingPages ManufacturingPage[]
  pageContents       PageContent[]
  passwordTokens     PasswordToken[]
  siteSettings       SiteSetting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String
  locale      Locale  @default(EN)
  description String?

  metaTitle       String?
  metaDescription String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  posts Post[]

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
  @@index([parentId])
  @@map("categories")
}

model Tag {
  id     String @id @default(cuid())
  name   String
  slug   String
  locale Locale @default(EN)

  posts PostTag[]

  createdAt DateTime @default(now())

  @@unique([slug, locale])
  @@map("tags")
}

model Post {
  id      String  @id @default(cuid())
  title   String
  slug    String
  locale  Locale  @default(EN)
  excerpt String?
  content String  @default("")

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  section     PostSection @default(NEWS)
  /// Editor-picked for the "Highlights" carousel at the top of the post's section index.
  isHighlight Boolean     @default(false)

  featuredImage    String? @db.VarChar(500)
  featuredImageAlt String?

  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  canonicalUrl    String? @db.VarChar(500)
  ogImage         String? @db.VarChar(500)
  noIndex         Boolean @default(false)

  readingTime Int @default(0)
  viewCount   Int @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  tags PostTag[]

  translationKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
  @@index([status, publishedAt])
  @@index([locale, status, section, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([translationKey])
  @@map("posts")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Media {
  id       String  @id @default(cuid())
  url      String  @db.VarChar(500)
  alt      String?
  fileName String
  mimeType String
  size     Int
  width    Int?
  height   Int?

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Downloads (Service -> Downloads, "Technical resource")
//
// Taxonomy is data, not code: the Figma sidebar's groups ("Solar panel
// modules", "Documents type", ...) are FilterGroup rows and their checkboxes
// are FilterOption rows, so an admin can add a group or an option without a
// deploy. A resource joins to many options through an explicit join table, so
// one datasheet can be a HJT Series document *and* a Datasheet *and* a
// Technical document at the same time.
//
// Localisation follows the Post/Category convention already in this schema:
// one row per locale, keyed by `locale`, rather than side-by-side translation
// columns. The binary file is language-neutral, so two locale rows may point at
// the same storage key -- deletion counts references before unlinking.
// ---------------------------------------------------------------------------

enum DownloadStatus {
  DRAFT
  PUBLISHED
}

model FilterGroup {
  id        String  @id @default(cuid())
  name      String
  slug      String
  locale    Locale  @default(EN)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  options FilterOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
  @@index([locale, sortOrder])
  @@map("filter_groups")
}

model FilterOption {
  id        String  @id @default(cuid())
  name      String
  slug      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  groupId String
  group   FilterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  downloads DownloadResourceFilterOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, slug])
  @@index([groupId, sortOrder])
  @@map("filter_options")
}

model DownloadResource {
  id          String  @id @default(cuid())
  title       String
  slug        String
  locale      Locale  @default(EN)
  description String?

  // Storage reference, never the bytes. `fileKey` is the storage-driver key
  // (lib/storage.ts); `fileUrl` is what the browser resolves.
  fileUrl  String @db.VarChar(500)
  fileKey  String @db.VarChar(500)
  fileName String
  mimeType String
  fileSize Int

  status        DownloadStatus @default(DRAFT)
  publishedAt   DateTime?
  displayOrder  Int            @default(0)
  downloadCount Int            @default(0)

  tags String[] @default([])

  filterOptions DownloadResourceFilterOption[]

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
  @@index([locale, status, displayOrder])
  @@index([status, publishedAt])
  @@index([uploadedById])
  @@map("download_resources")
}

model DownloadResourceFilterOption {
  downloadId String
  optionId   String

  download DownloadResource @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  option   FilterOption     @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([downloadId, optionId])
  @@index([optionId])
  @@map("download_resource_filter_options")
}

// ---------------------------------------------------------------------------
// Solutions & Projects pages (lightweight CMS)
//
// One reusable page template (SolutionsProjectTemplate) rendered from data. The
// whole page body — hero + fixed ordered sections + CTA — lives in `content` as
// typed JSON (lib/solutions-projects/types.ts owns its shape) so an admin edits
// a page from the dashboard without a deploy. Mega-menu placement is columns on
// the row (menuGroup / menuLabel / menuOrder / showInMegaMenu), so a published
// page appears in the header automatically and a draft/deleted one does not.
//
// Localisation follows the Post/Download convention: one row per locale, keyed
// by `locale`, unique on [slug, locale]. Status reuses DownloadStatus
// (DRAFT | PUBLISHED) — the same two-state publish gate.
// ---------------------------------------------------------------------------

enum SolutionMenuGroup {
  SOLUTIONS
  RENEWABLE_PROJECTS
}

model SolutionPage {
  id     String @id @default(cuid())
  title  String
  slug   String
  locale Locale @default(EN)

  status      DownloadStatus @default(DRAFT)
  publishedAt DateTime?

  // The Residential master template this whole page type was extracted from.
  // Protected so the admin can never delete the page every other Solutions
  // page's design derives from — deleteSolutionPage rejects it server-side
  // regardless of what the UI shows. Duplicating it does NOT copy this flag;
  // the copy is a normal, deletable page.
  isProtectedTemplate Boolean @default(false)

  // Mega-menu placement
  menuGroup      SolutionMenuGroup @default(SOLUTIONS)
  menuLabel      String
  menuOrder      Int               @default(0)
  showInMegaMenu Boolean           @default(true)

  // Kept for backward compatibility / quick access; superseded by `seo` below,
  // which is what generateMetadata and the dashboard's SEO panel actually use.
  metaTitle       String?
  metaDescription String? @db.VarChar(500)

  // Extended SEO / Open Graph / Twitter metadata JSON — same shape as
  // ManufacturingPage.seo (lib/solutions-projects/types.ts SolutionSeo).
  seo Json?

  // Full page body (hero + sections + cta). Shape: SolutionPageContent.
  content Json

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
  @@index([locale, status, menuGroup, menuOrder])
  @@index([status, publishedAt])
  @@map("solution_pages")
}

// ---------------------------------------------------------------------------
// Manufacturing product pages (lightweight CMS)
//
// One reusable template (ProductDetailPage) rendered from data. The full page
// body — hero + up to 17 optional sections — lives in `content` as typed JSON
// (ProductDetail, lib/data/products/types.ts). `seo` holds the extended SEO /
// social metadata as JSON. `category` is both the route base
// (/manufacturing/solar-panels|bess/<slug>) and the mega-menu group.
// ---------------------------------------------------------------------------

enum ManufacturingCategory {
  SOLAR_PANELS
  BESS
}

model ManufacturingPage {
  id       String                @id @default(cuid())
  title    String
  slug     String
  locale   Locale                @default(EN)
  category ManufacturingCategory

  status      DownloadStatus @default(DRAFT)
  publishedAt DateTime?

  // The BC master template this whole page type was extracted from. Protected
  // so it can never be deleted (server-enforced in deleteManufacturingPage,
  // not just hidden in the UI). Duplicating it does NOT copy this flag.
  isProtectedTemplate Boolean @default(false)

  menuLabel      String
  menuOrder      Int     @default(0)
  showInMegaMenu Boolean @default(true)

  // ProductDetail JSON (hero + sections).
  content Json
  // Extended SEO / Open Graph / Twitter metadata JSON. Falls back to content.meta.
  seo     Json?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, slug, locale])
  @@index([locale, status, category, menuOrder])
  @@index([status, publishedAt])
  @@map("manufacturing_pages")
}

// ---------------------------------------------------------------------------
// Website page content (Dashboard → Pages)
//
// The static marketing pages (home, about, manufacturing category pages, news
// room banners, downloads, header labels, footer) render their copy and images
// from next-intl messages (messages/<locale>.json). A row here holds an
// admin's *edits* to one page for one locale, as a partial message tree rooted
// at the messages root — only the leaves that differ from the shipped default,
// plus whole lists ("collections") the admin has changed. i18n/request.ts
// merges every row for the request's locale over the defaults
// (lib/page-content/merge.ts), so every page component keeps reading plain
// `t(...)` and an unedited page falls back to the default copy. Deleting the
// row restores the defaults.
// ---------------------------------------------------------------------------

model PageContent {
  id      String @id @default(cuid())
  /// Registry key from lib/page-content/registry.ts, e.g. "home", "manufacturing.solarPanels".
  pageKey String
  locale  Locale
  data    Json

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageKey, locale])
  @@index([locale])
  @@map("page_contents")
}

// ---------------------------------------------------------------------------
// Password links (forgot password, admin reset, new-account invitation)
//
// Only the SHA-256 of the token is stored — the raw token exists solely in the
// link that was emailed or copied, so a database read can't be turned into a
// working link. Single use (usedAt) and short-lived (expiresAt); issuing a new
// link for a user voids their older unused ones.
// ---------------------------------------------------------------------------

enum PasswordTokenPurpose {
  /// "Forgot password" or an admin-issued reset link.
  RESET
  /// A new account choosing its first password.
  INVITE
}

model PasswordToken {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String               @unique
  purpose   PasswordTokenPurpose @default(RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
  @@map("password_tokens")
}

// ---------------------------------------------------------------------------
// Site settings (Dashboard → Settings)
//
// Key/value rows for the few site-wide switches an admin changes without a
// deploy (lib/site-settings.ts owns the keys, defaults and validation). Secrets
// such as SMTP credentials never live here — they stay in the server's .env.
// ---------------------------------------------------------------------------

model SiteSetting {
  key   String @id
  value Json

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
